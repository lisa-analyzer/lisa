class loops {

	shortConst() {
		def x = 0;
		while (x < 2)
			x = x + 1;
		return x;
	}

	longConst() {
		def x = 0;
		while (x < 8)
			x = x + 1;
		return x;
	}

	unknownBound(b) {
		def x = 0;
		while (b)
			x = x + 1;
		return x;
	}

	nestedLoop() {
		def x = 0;
		def y = 0;
		while (x < 3) {
			y = 0;
			while (y < 5)
				y = y + 1;
			x = x + 1;
		}
		return y;
	}

	conditionalCounter() {
		def x = 0;
		def y = 0;
		while (x < 100) {
			if (x == 90)
				y = 42;
			x = x + 1;
		}
		return y;
	}
}
